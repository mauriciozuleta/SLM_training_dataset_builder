{
  "name": "pair-generation-desktop",
  "version": "0.1.0",
  "description": "Desktop app for generating question banks and training pairs.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "audit:pairs": "node scripts/audit_training_pairs.js",
    "audit:pairs:strict": "node scripts/audit_training_pairs.js --fail-on-warning",
    "check:training-ready": "node scripts/check_training_readiness.js",
    "check:training-ready:block": "node scripts/check_training_readiness.js --block-on-unresolved",
    "check:quality-stability": "node scripts/check_quality_stability.js",
    "check:quality-stability:require": "node scripts/check_quality_stability.js --require-stable"
  },
  "keywords": [
    "electron",
    "question-bank",
    "desktop"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^35.0.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
